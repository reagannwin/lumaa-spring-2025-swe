# Copy to .env and fill in. .env is gitignored.

PORT=5000

# Use either DATABASE_URL...
DATABASE_URL=postgres://taskapp:taskapp@localhost:5432/taskmanager

# ...or the individual settings (ignored when DATABASE_URL is set).
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=taskapp
# DB_PASSWORD=taskapp
# DB_NAME=taskmanager

# Required. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# The frontend's URL, for CORS.
CORS_ORIGIN=http://localhost:5173
